{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classrooms.schema.json",
  "title": "classroom50-progress classroom index",
  "description": "Data for the root page, generated by scripts/build_index.py. Lives at the repo root. Not edited by hand.",
  "type": "object",
  "required": ["schema", "last_run", "classrooms"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nsu-syspro/progress-classrooms/v1" },
    "last_run": {
      "type": ["object", "null"],
      "description": "Outcome of the most recent publish workflow run.",
      "required": ["conclusion"],
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "enum": ["success", "failure", "cancelled", "skipped", "timed_out"],
          "description": "Aggregate result of the publish jobs of the last run."
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When the run started."
        }
      }
    },
    "classrooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "generated_at"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "description": "Classroom directory name; also the ?classroom= parameter value." },
          "title": { "type": "string" },
          "generated_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
